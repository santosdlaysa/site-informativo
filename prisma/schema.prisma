// Prisma schema — MeuBlog
// Banco: PostgreSQL (Render). Camada de infraestrutura; o domínio não depende disto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PostType {
  STANDARD
  PROJECTS
}

enum EventFormat {
  PRESENTIAL
  ONLINE
  HYBRID
}

enum SessionStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  bio          String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  // chave da variante visual do badge (news | tec | saude | tut | eventos)
  variant   String   @default("tec")
  createdAt DateTime @default(now())

  posts    Post[]
  sessions ProgramSession[]
  events   Event[]
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String     @default("")
  coverImage  String?
  status      PostStatus @default(DRAFT)
  type        PostType   @default(STANDARD)
  readingTime Int        @default(5)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Para posts do tipo PROJECTS: galeria de itens que apontam para outros posts.
  galleryItems ProjectItem[] @relation("GalleryOwner")
  referencedBy ProjectItem[] @relation("LinkedPost")

  @@index([status])
  @@index([categoryId])
}

model ProjectItem {
  id       String  @id @default(cuid())
  image    String?
  caption  String?
  position Int     @default(0)

  ownerPostId String
  ownerPost   Post   @relation("GalleryOwner", fields: [ownerPostId], references: [id], onDelete: Cascade)

  linkedPostId String?
  linkedPost   Post?   @relation("LinkedPost", fields: [linkedPostId], references: [id])

  @@index([ownerPostId])
}

model ProgramSession {
  id          String        @id @default(cuid())
  title       String
  description String?
  speaker     String?
  speakerRole String?
  startsAt    DateTime
  durationMin Int           @default(60)
  status      SessionStatus @default(SCHEDULED)
  link        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  @@index([startsAt])
  @@index([categoryId])
}

model SiteSettings {
  id           String   @id @default("default")
  heroBgImage  String?
  qsImage      String?
  heroTag      String   @default("Fortalecimento de Vínculos")
  heroTitle    String   @default("Conectando famílias e\ngerando redes de apoio")
  heroDesc     String   @default("Nossos eventos de encerramento coroam meses de esforço, disciplina e união coletiva entre pais, alunos e orientadores.")
  heroCta1Text String   @default("Ver Galeria de Fotos")
  heroCta1Href String   @default("/acoes")
  heroCta2Text String   @default("Fale Conosco")
  heroCta2Href String   @default("/eventos")
  stat1Num     String   @default("150+")
  stat1Label   String   @default("Jovens Formados")
  stat2Num     String   @default("85+")
  stat2Label   String   @default("Famílias Apoiadas")
  stat3Num     String   @default("3")
  stat3Label   String   @default("Oficinas Ativas")
  stat4Num     String   @default("Boa Vista")
  stat4Label   String   @default("Roraima, Brasil")
  qsTag           String @default("Quem Somos")
  qsTitle         String @default("Compromisso com o futuro da nossa comunidade")
  qsBody1         String @default("O Centro Social Raros Boa Vista nasceu com o propósito de suprir as necessidades de capacitação, inserção digital e desenvolvimento artístico de crianças, adolescentes e jovens da região de Roraima.")
  qsBody2         String @default("Através de oficinas e acompanhamento próximo de profissionais e voluntários, fortalecemos as competências e talentos individuais, cultivando valores humanos cruciais como o respeito, a responsabilidade cidadã e a solidariedade local.")
  qsFeature1Title String @default("Inclusão Real")
  qsFeature1Desc  String @default("Acesso livre a cursos técnicos e artísticos.")
  qsFeature2Title String @default("Desenvolvimento Integral")
  qsFeature2Desc  String @default("Apoio psicossocial para jovens e pais.")
  socialFacebook  String @default("")
  socialTwitter   String @default("")
  socialLinkedin  String @default("")
  socialInstagram String @default("")
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?
  coverImage  String?
  format      EventFormat @default(PRESENTIAL)
  location    String?
  startsAt    DateTime
  capacity    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  @@index([startsAt])
  @@index([categoryId])
}
