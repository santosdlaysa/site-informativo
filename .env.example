# PostgreSQL hospedado no Render — copie este arquivo para .env e preencha.
# Use a "External Database URL" do Render (inclui ?sslmode=require).
DATABASE_URL="v"

# Segredo usado pelo Auth.js para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"

# Credenciais do administrador inicial criado pelo seed (prisma/seed.ts)
ADMIN_EMAIL="admin@meublog.com"
ADMIN_PASSWORD="senha123"
ADMIN_NAME="Admin"

# Ativa modo de manutenção — quando "true", redireciona todos os usuários para página /maintenance
SITE_MAINTENANCE="false"
